# ==============================================================
# THE REACTOR — Environment Variables
# lhex systems
# ==============================================================
# Copy this file to .env.local and fill in your values

# ==============================================================
# GROQ (Required for AI features — 100% FREE)
# Get your free key at: https://console.groq.com
# Free tier: generous limits, no credit card required
# Model used: llama-3.3-70b-versatile
# ==============================================================
GROQ_API_KEY=gsk_...

# ==============================================================
# ANTHROPIC (Optional — alternative to Groq)
# Get your key at: https://console.anthropic.com
# ==============================================================
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ==============================================================
# SUPABASE (Required for database)
# Get these from: https://app.supabase.com > Project Settings > API
# ==============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Os nomes NEXT_PUBLIC_* sao embutidos no BUILD. Em hospedagem (Vercel etc),
# uma variavel adicionada depois do build so vale no proximo build. Use estes
# nomes se quiser que a mudanca valha na hora, sem rebuild — nada do Supabase
# roda no navegador, entao o prefixo publico nao e necessario:
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================
# KOMMO CRM (Required to sync the sales pipeline)
# Kommo > Settings > Integrations > your integration > Access token
# The subdomain is the first part of your Kommo URL:
#   https://<subdomain>.kommo.com
# SUPABASE_SERVICE_ROLE_KEY above is also required — the sync writes rows.
# ==============================================================
KOMMO_SUBDOMAIN=your-subdomain
KOMMO_ACCESS_TOKEN=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9...

# ==============================================================
# KOMMO CHATS API (Optional — enables sending real WhatsApp messages
# through the Pipeline "Mensagens" tab, via Kommo's own chat channel)
# This is a DIFFERENT credential from KOMMO_ACCESS_TOKEN above: a chat
# channel scope_id + secret, issued by Kommo support after registering
# a chat channel integration — not self-service from the CRM token.
# https://developers.kommo.com/reference/send-import-messages
# Without these, messages are still logged inside the Reactor (visible
# to the team), just not pushed live to WhatsApp.
# ==============================================================
KOMMO_CHAT_SCOPE_ID=
KOMMO_CHAT_CHANNEL_SECRET=

# ==============================================================
# EVOLUTION API (Required for WhatsApp integration)
# Install Evolution API: https://github.com/EvolutionAPI/evolution-api
# ==============================================================
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=reactor-main

# Webhook URL that Evolution will call when messages arrive
# Set this in Evolution API dashboard
EVOLUTION_WEBHOOK_URL=https://your-domain.com/api/webhook/evolution

# ==============================================================
# CONTEXTO DA CLÍNICA (opcional)
# Texto entregue ao copiloto em toda pergunta. Se não definir,
# o padrão de src/lib/ai/clinic-context.ts é usado.
# ==============================================================
# REACTOR_CLINIC_CONTEXT="Clínica de estética avançada. Ticket médio alto..."

# ==============================================================
# APPLICATION (Optional customization)
# ==============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=The Reactor
NEXT_PUBLIC_COMPANY_NAME=lhex systems

# ==============================================================
# OPTIONAL INTEGRATIONS
# ==============================================================

# Redis (for production session/cache, optional)
# REDIS_URL=redis://localhost:6379

# Sentry (error monitoring, optional)
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# Analytics (optional)
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
